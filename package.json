    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "3.13.0",
    "husky": "8.0.3",
    "jsdom": "30.1.3",
    "license-checker-rseidelsohn": "4.2.10",
    "lint-staged": "15.0.1",
    "msw": "2.13.6",
