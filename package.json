{
  "name": "creator-credentials-ui",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "changeset:build": "pnpm tsc ./.changeset/changelog.generator.ts",
    "check:licenses": "node check-licenses.js",
    "dev": "docker compose --env-file .env.local -f docker/docker-compose.local.yaml up -d --build",
    "docker:base:dev": "docker compose --env-file .env.local -f docker/docker-compose.local.yaml up -d --build",
    "docker:base:prod": "docker compose --env-file .env.local.prod -f docker/docker-compose.prod.yaml up -d --build",
    "lint": "eslint --max-warnings=0 src",
    "prepare": "husky install",
    "prettier:check": "prettier -c .",
    "prettier:fix": "prettier . --write",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm prettier:check && pnpm lint && pnpm test:unit --run && pnpm changeset status",
    "start:dev": "next dev --webpack",
    "start:docker": "pnpm docker:base:dev up -V",
    "start:docker:prod": "pnpm docker:base:prod up",
    "start:prod": "next start -p $FRONTEND_APP_PORT",
    "start:prod:local": "next start",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "tsc --p tsconfig.test.json && vitest"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.22",
    "@hookform/resolvers": "5.2.2",
    "@metamask/sdk": "0.34.0",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.21.0",
    "clsx": "2.1.1",
    "flowbite": "2.5.1",
    "flowbite-react": "0.10.2",
    "i18next": "26.5.11",
    "i18next-http-backend": "3.0.6",
    "joi": "17.11.0",
    "next": "16.4.3",
    "next-auth": "4.24.14",
    "next-i18next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "2.6.1",
    "react-i18next": "17.1.9",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.26.2",
    "@changesets/types": "5.2.1",
    "@clerk/testing": "2.2.52",
    "@playwright/test": "1.64.1",
